msgid "Blocking"
msgstr "Bloquant"

msgid "Not verified"
msgstr "Non vérifié"

msgid "Running the server checks…"
msgstr "Vérification du serveur en cours…"

msgid "No blocking issue was detected by these checks."
msgstr "Aucun blocage détecté par ces contrôles."

msgid "An operation requires attention. Open the details below."
msgstr "Une opération nécessite une intervention. Consultez les détails ci-dessous."

msgid "Diagnostic incomplete. Some checks could not be verified."
msgstr "Diagnostic incomplet. Certains contrôles n’ont pas pu être vérifiés."

msgid "Diagnostic unavailable. Check your session and permissions, then retry."
msgstr "Diagnostic indisponible. Vérifiez votre session et vos autorisations, puis réessayez."

msgid "The browser has been asked to download the technical report."
msgstr "Le téléchargement du rapport technique a été demandé au navigateur."

msgid "Diagnostic access denied."
msgstr "Accès au diagnostic refusé."

msgid "Diagnostic could not complete. No automatic repair was performed."
msgstr "Le diagnostic n’a pas pu se terminer. Aucune réparation automatique n’a été effectuée."

