msgstr "Actions"

msgid "Description match:"
msgstr "Correspondance dans la description :"

msgid "Access details"
msgstr "Détails de l’accès"

msgid "Not public: restricted by its folder."
msgstr "Non public : accès limité par le dossier."

msgid "Arrival date unavailable for older documents"
msgstr "Date d’arrivée indisponible pour les anciens documents"

msgid "Unavailable in trash"
msgstr "Indisponible — dans la corbeille"

msgid "Previous access rules retained"
msgstr "Droits antérieurs conservés"

msgid "This file keeps the access rules of its previous location, even after reclassification."
msgstr "Ce fichier conserve les règles d’accès de son ancien emplacement, même après son reclassement."

msgid "Preview"
msgstr "Aperçu"

