msgstr "Logo public sélectionné"

msgid "Official FileWarden logo"
msgstr "Logo officiel FileWarden"

msgid "Import a logo"
msgstr "Importer un logo"

msgid "FileWarden logo"
msgstr "Logo FileWarden"

msgid "Public PNG or JPEG image, up to 2 MB and 6000 pixels per side. File-type restrictions for logos always apply."
msgstr "Image publique PNG ou JPEG, jusqu’à 2 Mo et 6 000 pixels par côté. Les restrictions de format des logos restent toujours applicables."

msgid "Show the logo"
msgstr "Afficher le logo"

msgid "Show the name"
msgstr "Afficher le nom"

