<?xml version="1.0"?>
<ruleset name="FileWarden">
  <description>WordPress coding standards for FileWarden.</description>
  <config name="installed_paths" value="vendor/wp-coding-standards/wpcs,vendor/phpcsstandards/phpcsutils,vendor/phpcsstandards/phpcsextra"/>
  <file>filewarden.php</file>
  <file>includes</file>
  <exclude-pattern>vendor/*</exclude-pattern>
  <rule ref="WordPress">
    <!-- PSR-4 filenames match the existing Composer namespace. -->
    <exclude name="WordPress.Files.FileName"/>
  </rule>
  <rule ref="WordPress.WP.Capabilities">
    <properties><property name="custom_capabilities" type="array">
      <element value="filewarden_read_all_files"/>
      <element value="filewarden_upload_files"/>
      <element value="filewarden_edit_files"/>
      <element value="filewarden_delete_files"/>
      <element value="filewarden_manage_permissions"/>
      <element value="filewarden_manage_settings"/>
      <element value="filewarden_view_audit"/>
    </property></properties>
  </rule>
  <rule ref="WordPress.Security.ValidatedSanitizedInput">
    <properties><property name="customSanitizingFunctions" type="array"><element value="FileWarden\RestController::integer"/><element value="RestController::integer"/></property></properties>
  </rule>
</ruleset>
